x = baseline_model.get_layer(\"resnet_preprocess\")(inputs) if arch == ModelArch.RESNET_50 else inputs\n        x = pruned_backbone(x)\n        x = baseline_model.get_layer(\"global_avg_pool\")(x)\n        x = baseline_model.get_layer(\"head_bn\")(x)\n        x = baseline_model.get_layer(\"head_dropout\")(x)\n        outputs = baseline_model.get_layer(f\"{arch.value}_output\")(x)\n        pruned_model = tf.keras.Model(inputs, outputs)\n\n        y_pred = np.argmax(pruned_model.predict(val_ds, verbose=0), axis=1)\n        unique_preds = np.unique(y_pred)\n\n        print(f\"\\n--- Rasio {ratio_pct}% ---\")\n        print(f\"Kelas unik yang diprediksi: {[class_names[i] for i in unique_preds]}\")\n        if len(unique_preds) == 1:\n            print(f\"⚠️⚠️⚠️  CONFIRMED COLLAPSE -- model HANYA memprediksi '{class_names[unique_preds[0]]}' untuk semua sample!\")\n        print(classification_report(y_true, y_pred, target_names=class_names, zero_division=0))\n\n        del pruned_model, pruned_backbone\n        gc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-06T06:35:28.645728Z","iopub.execute_input":"2026-08-06T06:35:28.646241Z","iopub.status.idle":"2026-08-06T06:35:30.022035Z","shell.execute_reply.started":"2026-08-06T06:35:28.646199Z","shell.execute_reply":"2026-08-06T06:35:30.020504Z"}},"outputs":[{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mNameError\u001b[0m                                 Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_58/82789372.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m      4\u001b[0m \u001b[0;31m# Rasio yang mencurigakan (plateau identik) untuk tiap model -- SESUAIKAN\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m      5\u001b[0m SUSPICIOUS_RATIOS = {\n\u001b[0;32m----> 6\u001b[0;31m     \u001b[0mModelArch\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mEFFICIE