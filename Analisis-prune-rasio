ne_row = df_macro.loc[df_macro[\"target_ratio_pct\"] == 0]\n    if baseline_row.empty:\n        print(\"  ⚠️  Baris baseline (0%) tidak ditemukan -- delta akurasi tidak bisa dihitung akurat.\")\n        baseline_acc = df_macro[\"zero_shot_accuracy\"].iloc[0]\n        baseline_entropy = df_macro[\"activation_entropy\"].iloc[0]\n    else:\n        baseline_acc = baseline_row[\"zero_shot_accuracy\"].iloc[0]\n        baseline_entropy = baseline_row[\"activation_entropy\"].iloc[0]\n\n    # --- Kolom turunan untuk memudahkan analisis ---\n    df_macro[\"accuracy_drop_abs\"] = (baseline_acc - df_macro[\"zero_shot_accuracy\"]).round(4)\n    df_macro[\"accuracy_drop_pct\"] = ((baseline_acc - df_macro[\"zero_shot_accuracy\"]) / baseline_acc * 100).round(2)\n    df_macro[\"accuracy_retention_pct\"] = (df_macro[\"zero_shot_accuracy\"] / baseline_acc * 100).round(2)\n    df_macro[\"entropy_drop_pct\"] = ((baseline_entropy - df_macro[\"activation_entropy\"]) / baseline_entropy * 100).round(2)\n    # Gap antara target rasio pruning vs realisasi aktual (structured pruning kadang tak presisi)\n    df_macro[\"target_vs_actual_gap_pct\"] = (df_macro[\"target_ratio_pct\"] - df_macro[\"params_reduced_pct\"]).round(2)\n    # Skor efisiensi sederhana: seberapa banyak compression didapat per 1% akurasi yang dikorbankan\n    df_macro[\"efficiency_score\"] = (\n        df_macro[\"params_reduced_pct\"] / df_macro[\"accuracy_drop_pct\"].replace(0, 0.01)\n    ).round(2)\n\n    all_macro[model_name] = df_macro\n    all_micro[model_name] = df_micro\n\n    print(f\"\\n  Baseline (0% pruning): akurasi = {baseline_acc:.4f} | entropy = {baseline_entropy:.4f}\")\n    print(f\"  Jumlah baris micro_metrics (detail layer): {len(df_micro)}\\n\")\n\n    display_cols = [\n        \"target_ratio_pct\", \"params_active\", \"params_reduced_pct\", \"target_vs_actual_gap_pct\",\n        \"zero_shot_accuracy\", \"accuracy_drop_pct\", \"accuracy_retention_pct\",\n        \"activation_entropy\", \"entropy_drop_pct\", \"efficiency_score\",\n    ]\n    with pd.option_context(\"display.max_columns\", None, \"display.width\", 160):\n        print(df_macro[display_cols].to_string(index=False))\n\n    # --- Peringatan otomatis untuk hal-hal yang perlu dicurigai ---\n    warnings = []\n    zero_reduction = df_macro[(df_macro[\"target_ratio_pct\"] > 0) & (df_macro[\"params_reduced_pct\"] < 1.0)]\n    if not zero_reduction.empty:\n        warnings.append(\n            f\"Rasio target {zero_reduction['target_ratio_pct'].tolist()} nyaris TIDAK mengurangi parameter sama sekali \"\n            f\"(params_reduced_pct < 1%) -- kemungkinan besar 'plans' kosong / bug dispatch arsitektur, cek micro_metrics.\"\n        )\n    big_gap = df_macro[df_macro[\"target_vs_actual_gap_pct\"].abs() > 15]\n    if not big_gap.empty:\n        warnings.append(\n            f\"Gap besar antara target vs realisasi compression di rasio {big_gap['target_ratio_pct'].tolist()} \"\n            f\"(selisih > 15 poin persen) -- realisasi structured pruning jauh dari target.\"\n        )\n    cliff = df_macro[df_macro[\"accuracy_drop_pct\"] > 15]\n    if not cliff.empty:\n        warnings.append(\n            f\"Penurunan akurasi drastis (>15%) mulai di rasio {cliff['target_ratio_pct'].min()}% -- \"\n            f\"kemungkinan 'cliff point' kapasitas model sudah terlampaui.\"\n        )\n\n    if warnings:\n        print(\"\\n  ⚠️  CATATAN OTOMATIS:\")\n        for w in warnings:\n            print(f\"     - {w}\")","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-08-06T06:25:48.356803Z","iopub.execute_input":"2026-08-06T06:25:48.357147Z","iopub.status.idle":"2026-08-06T06:25:50.356583Z","shell.execute_reply.started":"2026-08-06T06:25:48.357117Z","shell.execute_reply":"2026-08-06T06:25:50.355082Z"}},"outputs":[{"name":"stdout","text":"\n================================================================