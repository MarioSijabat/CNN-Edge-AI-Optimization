ce":"import matplotlib.pyplot as plt\n\nfig, axes = plt.subplots(2, 2, figsize=(16, 11))\ncolors = {\"EfficientNetB0\": \"#2E86AB\", \"MobileNetV3Small\": \"#A23B72\", \"ResNet50\": \"#F18F01\"}\n\n# --- Plot 1: Akurasi vs Rasio Pruning ---\nax = axes[0, 0]\nfor model_name, df in all_macro.items():\n    ax.plot(df[\"target_ratio_pct\"], df[\"zero_shot_accuracy\"], marker=\"o\",\n            label=model_name, color=colors.get(model_name))\nax.set_xlabel(\"Target Pruning Ratio (%)\")\nax.set_ylabel(\"Zero-Shot Accuracy (tanpa fine-tune)\")\nax.set_title(\"Kurva Information Loss: Akurasi vs Rasio Pruning\")\nax.legend()\nax.grid(alpha=0.3)\n\n# --- Plot 2: Akurasi vs Compression AKTUAL (bukan target) -- trade-off sebenarnya ---\nax = axes[0, 1]\nfor model_name, df in all_macro.items():\n    ax.plot(df[\"params_reduced_pct\"], df[\"zero_shot_accuracy\"], marker=\"o\",\n            label=model_name, color=colors.get(model_name))\nax.set_xlabel(\"Realisasi Pengurangan Parameter (%)\")\nax.set_ylabel(\"Zero-Shot Accuracy\")\nax.set_title(\"Trade-off Sebenarnya: Akurasi vs Compression Aktual\")\nax.legend()\nax.grid(alpha=0.3)\n\n# --- Plot 3: Activation Entropy vs Rasio (indikator information collapse) ---\nax = axes[1, 0]\nfor model_name, df in all_macro.items():\n    ax.plot(df[\"target_ratio_pct\"], df[\"activation_entropy\"], marker=\"o\",\n            label=model_name, color=colors.get(model_name))\nax.set_xlabel(\"Target Pruning Ratio (%)\")\nax.set_ylabel(\"Activation Entropy\")\nax.set_title(\"Feature Entropy vs Rasio Pruning\\n(penurunan tajam = sinyal fitur kolaps)\")\nax.legend()\nax.grid(alpha=0.3)\n\n# --- Plot 4: Efficiency Score (compression per 1% akurasi dikorbankan) ---\nax = axes[1, 1]\nfor model_name, df in all_macro.items():\n    valid = df[df[\"target_ratio_pct\"] > 0]\n    ax.plot(valid[\"target_ratio_pct\"], valid[\"efficiency_score\"], marker=\"o\",\n            label=model_name, color=colors.get(model_name))\nax.axhline(0, color=\"gray\", linewidth=0.8)\nax.set_xlabel(\"Target Pruning Ratio (%)\")\nax.set_ylabel(\"Efficiency Score (lebih tinggi = lebih efisien)\")\nax.set_title(\"Skor Efisiensi: %Compression / %Accuracy Drop\")\nax.legend()\nax.grid(alpha=0.3)\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-06T06:25:50.358588Z","iopub.execute_input":"2026-08-06T06:25:50.359057Z","iopub.status.idle":"2026-08-06T06:25:51.436788Z","shell.execute_reply.started":"2026-08-06T06:25:50.359027Z","shell.execute_reply":"2026-08-06T06:25:51.435693Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x1100 with 4 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":2},{"cell_type":"code","source":"# Ambang toleransi -- SESUAIKAN sesuai kebutuhan proyek Anda (edge device).\n# Semakin kecil MAX_ACCEPTABLE_DROP, semakin konservatif rekomendasinya.\nMAX_ACCEPTABLE_ACC_DROP_PCT = 3.0   # toleransi penurunan akurasi absolut (dalam %) vs baseline\n\nprint(\"=\" * 90)\nprint(\"🎯 REKOMENDASI RASIO PRUNING OPTIMAL PER MODEL (sebelum fine-tuning)\")\nprint(\"=\" * 90)\n\nrecommendations = {}\n\nfor model_name, df in all_macro.items():\n    candidates = df[(df[\"target_ratio_pct\"] > 0) & (df[\"accuracy_drop_pct\"] <= MAX_ACCEPTABLE_ACC_DROP_PCT)]\n\n    print(f\"\\n📌 {model_name}\")\n    if candidates.empty:\n        # Tidak ada rasio yang memenuhi toleransi -- ambil yang paling ringan penurunannya\n        fallback = df[df[\"target_ratio_pct\"] > 0].sort_values(\"accuracy_drop_pct\").iloc[0]\n        print(f\"   ⚠️  TIDAK ADA rasio yang memenuhi toleransi drop ≤{MAX_ACCEPTABLE_ACC_DROP_PCT}%.\")\n        print(f\"   Rasio dengan drop akurasi PALING RINGAN: {int(fallback['target_ratio_pct'])}% \"\n              f\"(drop {fallback['accuracy_drop_pct']:.2f}%, compression aktual {fallback['params_reduced_pct']:.2f}%)\")\n        print(f\"   -> Model ini sangat sensitif terhadap pruning -- pertimbangkan rasio kecil saja, \"\n              f\"atau strategi lain (mixed pruning/distillation) untuk arsitektur ini.\")\n        recommendations[model_name] = int(fallback[\"target_ratio_pct\"])\n        continue\n\n    # Di antara kandidat yang lolos toleransi akurasi, pilih compression TERBESAR\n    best = candidates.sort_values(\"params_reduced_pct\", ascending=False).iloc[0]\n\n    print(f\"   Kandidat yang lolos toleransi (drop ≤{MAX_ACCEPTABLE_ACC_DROP_PCT}%): \"\n          f\"{candidates['target_ratio_pct'].tolist()}\")\n    print(f\"   ✅ REKOMENDASI: rasio {int(best['target_ratio_pct'])}%\")\n    print(f\"      - Compression aktual   : {best['params_reduced_pct']:.2f}% parameter berkurang\")\n    print(f\"      - Akurasi zero-shot     : {best['zero_shot_accuracy']:.4f} \"\n          f\"(drop {best['accuracy_drop_pct']:.2f}% dari baseline)\")\n    print(f\"      - Activation entropy    : {best['activation_entropy']:.4f} \"\n          f\"(turun {best['entropy_drop_pct']:.2f}% dari baseline)\")\n    print(f\"      - Efficiency score      : {best['efficiency_score']:.2f}\")\n\n    recommendations[model_name] = int(best[\"target_ratio_pct\"])\n\nprint(\"\\n\" + \"=\" * 90)\nprint(\"RINGKASAN RASIO YANG DIREKOMENDASIKAN UNTUK TAHAP RECOVERY FINE-TUNING:\")\nprint(\"=\" * 90)\nfor model_name, ratio in recommendations.items():\n    print(f\"  {model_name:<20}: {ratio}%\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-06T06:25:51.438848Z","iopub.execute_input":"2026-08-06T06:25:51.439246Z","iopub.status.idle":"2026-08-06T06:25:51.461193Z","shell.execute_reply.started":"2026-08-06T06:25:51.439217Z","shell.execute_reply":"2026-08-06T06:25:51.46003Z"}},"outputs":[{"name":"stdout","text":"==========================================================================================\n🎯 REKOMENDASI RASIO PRUNING OPTIMAL PER MODEL (sebelum fine-tuning)\n==========================================================================================\n\n📌 EfficientNetB0\n   ⚠️  TIDAK ADA rasio yang memenuhi toleransi drop ≤3.0%.\n   Rasio dengan drop akurasi PALING RINGAN: 10% (drop 37.32%, compression aktual 8.91%)\n   -> Model ini sangat sensitif terhadap pruning -- pertimbangkan rasio kecil saja, atau strategi lain (mixed pruning/distillation) untuk arsitektur ini.\n\n📌 MobileNetV3Small\n   ⚠️  TIDAK ADA rasio yang memenuhi toleransi drop ≤3.0%.\n   Rasio dengan drop akurasi PALING RINGAN: 10% (drop 25.57%, compression aktual 12.13%)\n   -> Model ini sangat sensitif terhadap pruning -- pertimbangkan rasio kecil saja, atau strategi lain (mixed pruning/distillation) untuk arsitektur ini.\n\n📌 ResNet50\n   ⚠️  TIDAK ADA rasio yang memenuhi toleransi drop ≤3.0%.\n   Rasio dengan drop akurasi PALING RINGAN: 10% (drop 3.67%, compression aktual 12.92%)\n   -> Model ini sangat sensitif terhadap pruning -- pertimbangkan rasio kecil saja, atau strategi lain (mixed pruning/distillation) untuk arsitektur ini.\n\n==========================================================================================\nRINGKASAN RASIO YANG DIREKOMENDASIKAN UNTUK TAHAP RECOVERY FINE-TUNING:\n==========================================================================================\n  EfficientNetB0      : 10%\n  MobileNetV3Small    : 10%\n  ResNet50            : 10%\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\ndef find_knee_point(x_vals, y_vals):\n    \"\"\"\n    Deteksi knee/elbow point pakai metode geometris (mirip algoritma Kneedle):\n    cari titik dengan jarak tegak lurus TERJAUH dari garis lurus yang\n    menghubungkan titik pertama & terakhir kurva.\n    x_vals: params_reduced_pct (compression aktual)\n    y_vals: zero_shot_accuracy (atau bisa juga accuracy_drop_pct)\n    \"\"\"\n    x = np.array(x_vals, dtype=float)\n    y = np.array(y_vals, dtype=float)\n\n    # Normalisasi ke 0-1 supaya skala x (persen) & y (akurasi) sebanding\n    x_norm = (x - x.min()) / (x.max() - x.min() + 1e-9)\n    y_norm = (y - y.min()) / (y.max() - y.min() + 1e-9)\n\n    # Garis lurus dari titik awal ke titik akhir\n    p1 = np.array([x_norm[0], y_norm[0]])\n    p2 = np.array([x_norm[-1], y_norm[-1]])\n    line_vec = p2 - p1\n    line_len = np.linalg.norm(line_vec)\n    line_unit = line_vec / (line_len + 1e-9)\n\n    distances = []\n    for xi, yi in zip(x_norm, y_norm):\n        point = np.array([xi, yi]) - p1\n        proj_len = np.dot(point, line_unit)\n        proj_point = proj_len * line_unit\n        perp_vec = point - proj_point\n        distances.append(np.linalg.norm(perp_vec))\n\n    knee_idx = int(np.argmax(distances))\n    return knee_idx, distances\n\n\nprint(\"=\" * 90)\nprint(\"🔎 KNEE-POINT DETECTION -- Titik Kompresi Agresif Namun Masih Recoverable\")\nprint(\"=\" * 90)\n\nknee_recommendations = {}\n\nfor model_name, df in all_macro.items():\n    df_nonzero = df[df[\"target_ratio_pct\"] > 0].reset_index(drop=True)\n    if len(df_nonzero) < 3:\n        continue\n\n    knee_idx, distances = find_knee_point(\n        df_nonzero[\"params_reduced_pct\"].values,\n        df_nonzero[\"zero_shot_accuracy\"].values,\n    )\n    knee_row = df_nonzero.iloc[knee_idx]\n\n    # Hitung juga marginal cost: berapa % akurasi hilang per 10% compression tambahan,\n    # sebagai konfirmasi kuantitatif titik knee ini\n    df_nonzero[\"marginal_acc_loss_per_10pct_compression\"] = (\n        df_nonzero[\"accuracy_drop_pct\"].diff() /\n        (df_nonzero[\"params_reduced_pct\"].diff() / 10.0)\n    ).round(2)\n\n    print(f\"\\n📌 {model_name}\")\n    with pd.option_context(\"display.max_columns\", None, \"display.width\", 160):\n        print(df_nonzero[[\"target_ratio_pct\", \"params_reduced_pct\", \"zero_shot_accuracy\",\n                           \"accuracy_drop_pct\", \"activation_entropy\",\n                           \"marginal_acc_loss_per_10pct_compression\"]].to_string(index=False))\n\n    print(f\"\\n   🎯 KNEE POINT terdeteksi di rasio target: {int(knee_row['target_ratio_pct'])}%\")\n    print(f\"      - Compression aktual   : {knee_row['params_reduced_pct']:.2f}%\")\n    print(f\"      - Akurasi zero-shot     : {knee_row['zero_shot_accuracy']:.4f} \"\n          f\"(drop {knee_row['accuracy_drop_pct']:.2f}%)\")\n    print(f\"      -> Ini kandidat rasio AGRESIF-TAPI-MASIH-RECOVERABLE untuk fine-tuning.\")\n\n    knee_recommendations[model_name] = int(knee_row[\"target_ratio_pct\"])\n\nprint(\"\\n\" + \"=\" * 90)\nprint(\"RINGKASAN KANDIDAT RASIO (berbasis knee-point, untuk footprint ekstrem):\")\nprint(\"=\" * 90)\nfor model_name, ratio in knee_recommendations.items():\n    print(f\"  {model_name:<20}: {ratio}%\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-06T06:31:06.183694Z","iopub.execute_input":"2026-08-06T06:31:06.184445Z","iopub.status.idle":"2026-08-06T06:31:06.219018Z","shell.execute_reply.started":"2026-08-06T06:31:06.184407Z","shell.execute_reply":"2026-08-06T06:31:06.218034Z"}},"outputs":[{"name":"stdout","text":"==========================================================================================\n🔎 KNEE-POINT DETECTION -- Titik Kompresi Agresif Namun Masih Recoverable\n==========================================================================================\n\n📌 EfficientNetB0\n target_ratio_pct  params_reduced_pct  zero_shot_accuracy  accuracy_drop_pct  activation_entropy  marginal_acc_loss_per_10pct_compression\n               10              8.9100              0.5742            37.3200              7.1581                                      NaN\n               20             17.8300              0.3871            57.7400             10.0658                                  22.8900\n               30             26.7400              0.3097            66.1900             10.7428                                   9.4800\n               40             35.6600              0.3355            63.3800             10.9879                                  -3.1500\n               50    